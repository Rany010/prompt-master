# Netlify Database Configuration Template
# 复制此文件为 .env 并填入实际的数据库连接字符串

# 主连接字符串（用于常规查询）
NETLIFY_DATABASE_URL=postgresql://[user]:[password]@[host]/[database]

# 无池连接字符串（用于事务和迁移）
NETLIFY_DATABASE_URL_UNPOOLED=postgresql://[user]:[password]@[host]/[database]?sslmode=require

# 使用方法：
# 1. 登录 Netlify 控制台
# 2. 进入你的站点 → Integrations → Neon
# 3. 复制 NETLIFY_DATABASE_URL 的值
# 4. 在本地创建 .env 文件并粘贴
# 5. 运行 netlify dev 进行本地开发

